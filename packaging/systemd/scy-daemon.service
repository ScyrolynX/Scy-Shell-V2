[Unit]
Description=Scy-Shell v2.0 Unified Coordinator, Persistence Ledger & Single-Owner Arbitrator
Documentation=https://github.com/scy-shell/scy-shell
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
Type=simple
ExecStart=%h/.local/bin/scy-daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
