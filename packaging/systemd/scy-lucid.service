[Unit]
Description=Scy-Shell v2.0 — Primary Wayland Shell & Unified 15-Section Studio (Quickshell)
PartOf=graphical-session.target
After=scy-daemon.service
Requires=scy-daemon.service

[Service]
Type=simple
ExecStart=%h/.local/bin/scy-launch-engine lucid
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
